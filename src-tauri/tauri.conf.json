{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrayBits",
  "version": "0.1.0",
  "identifier": "com.nakorncode.traybits",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TrayBits",
        "width": 1040,
        "height": 720,
        "minWidth": 920,
        "minHeight": 620
      },
      {
        "label": "toast",
        "title": "TrayBits Toast Overlay",
        "url": "index.html?view=toast",
        "width": 440,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../assets/sounds/opencode-complete.wav",
      "../assets/sounds/opencode-permission.wav",
      "../assets/sounds/opencode-question.wav",
      "../assets/sounds/opencode-error.wav",
      "../assets/sounds/opencode-subagent-complete.wav",
      "../assets/sounds/kenney-switch-2.wav",
      "../assets/sounds/kenney-switch-20.wav",
      "../assets/sounds/kenney-click-3.wav",
      "../assets/sounds/kenney-rollover-4.wav",
      "../assets/sounds/traybits-notification.wav"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
