      "../assets/sounds/aosp-strontium.wav",
      "../assets/sounds/aosp-syrma.wav",
      "../assets/sounds/aosp-talitha.wav",
      "../assets/sounds/aosp-tejat.wav",
      "../assets/sounds/aosp-tethys.wav",
      "../assets/sounds/aosp-thallium.wav",
      "../assets/sounds/aosp-titan.wav",
      "../assets/sounds/aosp-vega.wav"
